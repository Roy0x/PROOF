# v0.4 live Nemotron preparation. Never commit a populated .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
PROOF_NEMOTRON_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional inference read inactivity timeout: 10-120 seconds (default 60).
# PROOF_NEBIUS_READ_TIMEOUT_SECONDS=60
# Optional per-stage completion caps (default compiler 1024, planner 2048; hard cap 4096).
# PROOF_COMPILER_MAX_OUTPUT_TOKENS=1024
# PROOF_PLANNER_MAX_OUTPUT_TOKENS=2048
# Server-owned target configuration for /api/v0.4/prepare.
PROOF_PRODUCTION_BASE_URL=
# Optional: PROOF_WORKSPACE, PROOF_ROUTES_JSON, PROOF_SELECTORS_JSON,
# PROOF_TEST_USERNAME, PROOF_TEST_PASSWORD.
